{%- comment -%}
  rl-care-guides — blog videos grouped by section blocks (title + blog tag).
  Article metafields: custom.youtube_url (preferred), custom.mp4_file (fallback).
  Click opens lightbox (does not go to article).
  Needs assets: rl-base.css, rl-care.css, rl-care.js
{%- endcomment -%}
{{ 'rl-base.css' | asset_url | stylesheet_tag }}
{{ 'rl-care.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign blog = s.blog
  assign preview = s.preview_per_category | default: 3
  assign meta_label = s.meta_label | default: 'Video guide'
  assign playable_count = 0
  assign cat_count = section.blocks.size
-%}

{%- if blog != blank -%}
  {%- for article in blog.articles -%}
    {%- liquid
      assign yt = article.metafields.custom.youtube_url.value
      assign mp4 = article.metafields.custom.mp4_file.value
      assign has_video = false
      if yt != blank
        assign has_video = true
      elsif mp4 != blank
        assign has_video = true
      endif
    -%}
    {%- if has_video -%}
      {%- assign playable_count = playable_count | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

<section
  class="rl-section rl-care-guides"
  data-rl-care-guides
  style="
    --rl-accent: {{ s.accent_color }};
    --rl-heading: {{ s.heading_color }};
    --rl-bg: {{ s.section_bg }};
    --rl-maxw: {{ s.max_width }}px;
    --rl-pt: {{ s.padding_top }}px;
    --rl-pb: {{ s.padding_bottom }}px;
    --cg-muted: {{ s.text_color }};
  "
>
  <div class="rl-care-guides__wrap">
    <div class="rl-care-guides__head">
      <div>
        {%- if s.eyebrow != blank -%}
          <p class="rl-care-guides__eyebrow">{{ s.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="rl-care-guides__title">{{ s.heading | escape }}</h2>
        {%- endif -%}
        {%- if s.description != blank -%}
          <div class="rl-care-guides__intro rte">{{ s.description }}</div>
        {%- endif -%}
      </div>
      {%- if s.show_count and playable_count > 0 and cat_count > 0 -%}
        <p class="rl-care-guides__count">
          {{ playable_count }} video guides across {{ cat_count }} categories
        </p>
      {%- endif -%}
    </div>

    {%- if blog == blank -%}
      {%- if request.design_mode -%}
        <p>Select a blog in the section settings.</p>
      {%- endif -%}
    {%- elsif section.blocks.size == 0 -%}
      {%- if request.design_mode -%}
        <p>Add “Category” blocks. Each block needs a title and a blog tag.</p>
      {%- endif -%}
    {%- else -%}
      <ul class="rl-care-guides__filters" role="list">
        <li>
          <button type="button" class="rl-care-guides__pill is-active" data-rl-care-filter="all" aria-pressed="true">
            All Guides
          </button>
        </li>
        {%- for block in section.blocks -%}
          {%- liquid
            assign b = block.settings
            assign tag_name = b.tag_custom | strip
            if tag_name == blank
              assign tag_name = b.tag | strip
            endif
            assign block_title = b.title | strip
            if block_title == blank
              assign block_title = tag_name
            endif
            assign filter_handle = block.id
          -%}
          {%- if tag_name != blank -%}
            <li {{ block.shopify_attributes }}>
              <button
                type="button"
                class="rl-care-guides__pill"
                data-rl-care-filter="{{ filter_handle | escape }}"
                aria-pressed="false"
              >
                {{ block_title | escape }}
              </button>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign tag_name = b.tag_custom | strip
          if tag_name == blank
            assign tag_name = b.tag | strip
          endif
          assign block_title = b.title | strip
          if block_title == blank
            assign block_title = tag_name
          endif
          assign filter_handle = block.id
          assign tag_handle = tag_name | handleize
          assign shown = 0
          assign total_in_cat = 0
        -%}
        {%- if tag_name == blank -%}{%- continue -%}{%- endif -%}

        {%- if blog != blank -%}
          {%- for article in blog.articles -%}
            {%- liquid
              assign yt = article.metafields.custom.youtube_url.value
              assign mp4 = article.metafields.custom.mp4_file.value
              assign has_video = false
              if yt != blank
                assign has_video = true
              elsif mp4 != blank
                assign has_video = true
              endif
            -%}
            {%- if has_video and article.tags contains tag_name -%}
              {%- assign total_in_cat = total_in_cat | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

        <section
          class="rl-care-guides__group"
          data-rl-care-group="{{ filter_handle | escape }}"
          {{ block.shopify_attributes }}
        >
          <div class="rl-care-guides__group-head">
            <h3 class="rl-care-guides__group-title">{{ block_title | escape }}</h3>
            {%- if total_in_cat > preview -%}
              <a class="rl-care-guides__view-all" href="{{ blog.url }}/tagged/{{ tag_handle }}?view=care">View all</a>
            {%- endif -%}
          </div>

          <ul class="rl-care-guides__grid" role="list">
            {%- if blog != blank -%}
              {%- for article in blog.articles -%}
                {%- if shown >= preview -%}{%- break -%}{%- endif -%}
                {%- liquid
                  assign yt = article.metafields.custom.youtube_url.value
                  assign mp4 = article.metafields.custom.mp4_file.value
                  assign video_type = ''
                  assign video_src = ''
                  if yt != blank
                    assign video_type = 'youtube'
                    assign video_src = yt
                  elsif mp4 != blank
                    assign video_type = 'mp4'
                    if mp4.url != blank
                      assign video_src = mp4.url
                    else
                      assign video_src = mp4 | file_url
                    endif
                  endif
                -%}
                {%- if video_src != blank and article.tags contains tag_name -%}
                  {%- assign shown = shown | plus: 1 -%}
                  <li class="rl-care-card">
                    <button
                      type="button"
                      class="rl-care-card__btn"
                      data-rl-care-play
                      data-video-type="{{ video_type }}"
                      data-video-src="{{ video_src | escape }}"
                      aria-label="Play video: {{ article.title | escape }}"
                    >
                      <span class="rl-care-card__thumb">
                        {%- if article.image != blank -%}
                          {{
                            article.image
                            | image_url: width: 800
                            | image_tag:
                              loading: 'lazy',
                              widths: '400, 600, 800',
                              sizes: '(min-width: 990px) 30vw, 90vw',
                              alt: article.title
                          }}
                        {%- else -%}
                          {{ 'image' | placeholder_svg_tag }}
                        {%- endif -%}
                        <span class="rl-care-card__play" aria-hidden="true">
                          <img
                            class="rl-care-card__play-icon"
                            src="https://cdn.shopify.com/s/files/1/0275/9239/2768/files/a2fd4f28b2926d0e24f56c47b26880fd48c311cb.png?v=1792672660"
                            alt=""
                            width="85"
                            height="85"
                            loading="lazy"
                          >
                        </span>
                      </span>
                      <span class="rl-care-card__title">{{ article.title | escape }}</span>
                      <span class="rl-care-card__meta">
                        <span class="rl-care-card__dot" aria-hidden="true"></span>
                        {{ meta_label | escape }} · {{ block_title | escape }}
                      </span>
                    </button>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}

            {%- if shown == 0 -%}
              <li class="rl-care-guides__empty">
                <p class="rl-care-guides__empty-text">No video Available for this category</p>
              </li>
            {%- endif -%}
          </ul>
        </section>
      {%- endfor -%}
    {%- endif -%}
  </div>

  <div class="rl-care-lightbox" data-rl-care-lightbox hidden>
    <button type="button" class="rl-care-lightbox__backdrop" data-rl-care-backdrop aria-label="Close video"></button>
    <div class="rl-care-lightbox__dialog" role="dialog" aria-modal="true" aria-label="Video player">
      <button type="button" class="rl-care-lightbox__close" data-rl-care-close aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"/>
        </svg>
      </button>
      <div class="rl-care-lightbox__player" data-rl-care-player></div>
    </div>
  </div>
</section>

<script src="{{ 'rl-care.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "RL Care guides",
  "tag": "section",
  "class": "section-rl-care-guides",
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog",
      "info": "Posts need a matching tag plus custom.youtube_url or custom.mp4_file."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "HELPFUL HOW-TO VIDEOS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore Care Guides"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Browse simple maintenance tutorials to keep your appliances working their best.</p>"
    },
    {
      "type": "text",
      "id": "meta_label",
      "label": "Card meta label",
      "default": "Video guide"
    },
    {
      "type": "range",
      "id": "preview_per_category",
      "min": 1,
      "max": 9,
      "step": 1,
      "label": "Videos per category (preview)",
      "default": 3,
      "info": "“View all” appears when a category has more than this."
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show video count",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "label": "Max width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 64
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#d0021b"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Description",
      "default": "#777777"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Refrigerators",
          "info": "Shown as the category heading and filter pill."
        },
        {
          "type": "select",
          "id": "tag",
          "label": "Blog tag",
          "info": "Must match the tag on blog posts exactly. Shopify cannot load tags live into this list — add custom below if needed.",
          "options": [
            { "value": "Refrigerators", "label": "Refrigerators" },
            { "value": "Washing Machines", "label": "Washing Machines" },
            { "value": "Air Conditioners", "label": "Air Conditioners" },
            { "value": "Televisions", "label": "Televisions" },
            { "value": "Kitchen Appliances", "label": "Kitchen Appliances" },
            { "value": "Small Appliances", "label": "Small Appliances" }
          ],
          "default": "Refrigerators"
        },
        {
          "type": "text",
          "id": "tag_custom",
          "label": "Custom blog tag",
          "info": "Optional. If filled, this overrides the dropdown. Must match the post tag exactly."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "RL Care guides",
      "blocks": [
        { "type": "category", "settings": { "title": "Refrigerators", "tag": "Refrigerators" } },
        { "type": "category", "settings": { "title": "Washing Machines", "tag": "Washing Machines" } },
        { "type": "category", "settings": { "title": "Air Conditioners", "tag": "Air Conditioners" } },
        { "type": "category", "settings": { "title": "Televisions", "tag": "Televisions" } },
        { "type": "category", "settings": { "title": "Kitchen Appliances", "tag": "Kitchen Appliances" } },
        { "type": "category", "settings": { "title": "Small Appliances", "tag": "Small Appliances" } }
      ]
    }
  ]
}
{% endschema %}
