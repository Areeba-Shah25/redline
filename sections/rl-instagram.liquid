{%- comment -%}
  rl-instagram — "We're on Gram" infinite carousel (manual posts + optional live feed)
  Needs assets: rl-base.css, rl-carousel.css, rl-instagram.css, rl-carousel.js (+ rl-instagram.js only for live feed)
{%- endcomment -%}
{{ 'rl-base.css' | asset_url | stylesheet_tag }}
{{ 'rl-carousel.css' | asset_url | stylesheet_tag }}
{{ 'rl-instagram.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
{%- assign handle = s.handle | remove: '@' -%}
{%- if s.profile_url != blank -%}{%- assign profile_url = s.profile_url -%}{%- else -%}{%- assign profile_url = 'https://www.instagram.com/' | append: handle -%}{%- endif -%}

{%- capture ig_icon -%}
  <svg class="rl-ig__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none"/></svg>
{%- endcapture -%}

<section
  class="rl-section rl-ig rl-car"
  data-rl-carousel data-centered="true"
  data-autoplay="{{ s.autoplay }}" data-speed="{{ s.autoplay_speed | times: 1000 }}"
  {%- if s.feed_endpoint != blank %}
  data-ig-endpoint="{{ s.feed_endpoint | escape }}" data-ig-limit="{{ s.feed_limit }}" data-ig-handle="@{{ handle }}"
  data-ig-avatar="{% if s.avatar != blank %}{{ s.avatar | image_url: width: 100, height: 100 }}{% endif %}"
  {%- endif %}
  style="--rl-bg:{{ s.section_bg }};--rl-heading:{{ s.heading_color }};--rl-text:{{ s.text_color }};--ig-card:{{ s.card_bg }};--rl-pt:{{ s.padding_top }}px;--rl-pb:{{ s.padding_bottom }}px;--car-pv-d:{{ s.slides_desktop }};--car-pv-t:{{ s.slides_tablet }};--car-pv-m:{{ s.slides_mobile }};--car-gap-d:32px;--car-gap-t:24px;--car-gap-m:16px;"
>
  {%- if s.heading != blank -%}<h2 class="rl-heading rl-ig__heading">{{ s.heading }}</h2>{%- endif -%}

  <div class="rl-car__viewport" tabindex="0" role="region" aria-roledescription="carousel" aria-label="{{ s.heading | escape }}">
    <div class="rl-car__track">
      {%- for block in section.blocks -%}
        <div class="rl-car__slide" {{ block.shopify_attributes }}>
          <a class="rl-ig__card" href="{{ block.settings.link | default: profile_url }}" target="_blank" rel="noopener" draggable="false" aria-label="View post on Instagram">
            <div class="rl-ig__media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 500, 700', sizes: '(min-width: 990px) 25vw, 70vw', alt: block.settings.alt }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag }}
              {%- endif -%}
            </div>
            <div class="rl-ig__foot">
              <span class="rl-ig__avatar">
                {%- if s.avatar != blank -%}
                  {{ s.avatar | image_url: width: 100, height: 100 | image_tag: loading: 'lazy', alt: '' }}
                {%- else -%}
                  {{ handle | slice: 0 }}
                {%- endif -%}
              </span>
              <span class="rl-ig__handle">@{{ handle }}</span>
              {{ ig_icon }}
            </div>
          </a>
        </div>
      {%- endfor -%}
    </div>
  </div>

  {%- if s.link_text != blank -%}
    <div class="rl-ig__follow"><a href="{{ profile_url }}" target="_blank" rel="noopener">{{ s.link_text }}</a></div>
  {%- endif -%}

  <template data-ig-icon>{{ ig_icon }}</template>
</section>

<script src="{{ 'rl-carousel.js' | asset_url }}" defer></script>
{%- if s.feed_endpoint != blank -%}<script src="{{ 'rl-instagram.js' | asset_url }}" defer></script>{%- endif -%}

{% schema %}
{
  "name": "RL Instagram feed",
  "tag": "div",
  "class": "section-rl-instagram",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We’re on Gram" },

    { "type": "header", "content": "Instagram account" },
    { "type": "text", "id": "handle", "label": "Instagram username", "default": "redline.mu", "info": "Shown on every card (without @)." },
    { "type": "image_picker", "id": "avatar", "label": "Profile picture", "info": "Round logo on each card. Square image recommended." },
    { "type": "url", "id": "profile_url", "label": "Profile link", "info": "Empty = instagram.com/your-username" },
    { "type": "text", "id": "link_text", "label": "Link text under the slider", "default": "@Redline.Mu", "info": "Empty = hidden." },

    { "type": "header", "content": "Live feed (optional)" },
    { "type": "url", "id": "feed_endpoint", "label": "Feed endpoint URL", "info": "Advanced: URL returning Instagram Graph API media JSON. Empty = use the manual posts below." },
    { "type": "range", "id": "feed_limit", "label": "Max live posts", "min": 4, "max": 24, "step": 2, "default": 12 },

    { "type": "header", "content": "Slider" },
    { "type": "select", "id": "slides_desktop", "label": "Cards on desktop", "options": [ { "value": "3.5", "label": "3.5 (large)" }, { "value": "4.5", "label": "4.5 (as in design)" }, { "value": "5.5", "label": "5.5 (small)" } ], "default": "4.5" },
    { "type": "select", "id": "slides_tablet", "label": "Cards on tablet", "options": [ { "value": "1.5", "label": "1.5" }, { "value": "2.5", "label": "2.5" }, { "value": "3.5", "label": "3.5" } ], "default": "2.5" },
    { "type": "select", "id": "slides_mobile", "label": "Cards on mobile", "options": [ { "value": "1", "label": "1" }, { "value": "1.3", "label": "1.3 (peek next card)" }, { "value": "1.6", "label": "1.6" } ], "default": "1.3" },
    { "type": "checkbox", "id": "autoplay", "label": "Auto-scroll", "default": true },
    { "type": "range", "id": "autoplay_speed", "label": "Seconds per slide", "min": 2, "max": 10, "step": 1, "default": 4 },

    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "section_bg", "label": "Section background", "default": "#f4f4f0" },
    { "type": "color", "id": "heading_color", "label": "Heading & link", "default": "#000000" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Card text & icon", "default": "#111111" },

    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top space", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom space", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Post",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Post image" },
        { "type": "url", "id": "link", "label": "Post link", "info": "Instagram post URL. Empty = opens the profile." },
        { "type": "text", "id": "alt", "label": "Image description (accessibility)" }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    { "name": "RL Instagram feed", "blocks": [ { "type": "post" }, { "type": "post" }, { "type": "post" }, { "type": "post" }, { "type": "post" }, { "type": "post" } ] }
  ]
}
{% endschema %}
