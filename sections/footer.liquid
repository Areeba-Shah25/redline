{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{{ 'section-footer.css' | asset_url | stylesheet_tag }}
{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}
{{ 'component-list-menu.css' | asset_url | stylesheet_tag }}
{{ 'component-list-payment.css' | asset_url | stylesheet_tag }}
{{ 'component-list-social.css' | asset_url | stylesheet_tag }}
{{ 'redline-footer.css' | asset_url | stylesheet_tag }}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;800&display=swap" rel="stylesheet">

{%- style -%}
  .footer {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .redline-footer-{{ section.id }} {
    --rf-bg: {{ section.settings.background_color | default: '#1A1E21' }};
    --rf-text: {{ section.settings.text_color | default: '#FFFFFF' }};
    --rf-muted: {{ section.settings.muted_text_color | default: '#B8B8B8' }};
    --rf-panel: {{ section.settings.newsletter_panel_color | default: '#22272B' }};
    --rf-accent-gradient: linear-gradient(180deg, #e1061d 0%, #b50417 100%);
    --rf-accent: #e1061d;
  }

  @media screen and (min-width: 750px) {
    .footer {
      margin-top: {{ section.settings.margin_top }}px;
    }

    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* —— Copyright bar (styles kept in this file) —— */
  .redline-footer-{{ section.id }} .redline-footer__copyright {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    margin-top: 4rem;
    padding-top: 1.8rem;
    padding-bottom: 0.4rem;
  }

  .redline-footer-{{ section.id }} .redline-footer__copyright-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.6rem 2.4rem;
  }

  .redline-footer-{{ section.id }} .redline-footer__copyright-left,
  .redline-footer-{{ section.id }} .redline-footer__copyright-right {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .redline-footer-{{ section.id }} .redline-footer__copyright-left {
    flex: 1 1 auto;
    min-width: 0;
  }

  .redline-footer-{{ section.id }} .redline-footer__copyright-right {
    flex: 0 1 auto;
    justify-content: flex-end;
  }

  .redline-footer-{{ section.id }} .redline-footer__copyright-item {
    display: inline-flex;
    align-items: center;
  }

  .redline-footer-{{ section.id }} .redline-footer__copyright-item:not(:last-child)::after {
    content: '';
    display: inline-block;
    width: 1px;
    height: 1.2rem;
    margin: 0 1.2rem;
    background: rgba(255, 255, 255, 0.45);
  }

  .redline-footer-{{ section.id }} .redline-footer__copyright-text,
  .redline-footer-{{ section.id }} .redline-footer__copyright-link {
    font-family: 'Manrope', sans-serif;
    font-weight: 500;
    font-size: 1.4rem;
    line-height: 1.4;
    letter-spacing: 0;
    color: var(--rf-text, #ffffff);
    text-decoration: none;
    white-space: nowrap;
  }

  .redline-footer-{{ section.id }} .redline-footer__copyright-link:hover {
    opacity: 0.8;
    text-decoration: underline;
    text-underline-offset: 0.2rem;
  }

  .redline-footer-{{ section.id }} .redline-footer__payments {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .redline-footer-{{ section.id }} .redline-footer__payment-item {
    display: inline-flex;
    align-items: center;
    line-height: 0;
  }

  .redline-footer-{{ section.id }} .redline-footer__payment-item .icon,
  .redline-footer-{{ section.id }} .redline-footer__payment-item svg {
    height: 2.2rem;
    width: auto;
  }

  .redline-footer-{{ section.id }} .redline-footer__payment-image {
    display: block;
    height: 50px;
    width: auto;
    object-fit: contain;
  }

  .redline-footer-{{ section.id }} .redline-footer__slogan {
    margin: 0;
    font-family: 'Manrope', sans-serif;
    font-weight: 500;
    font-size: 1.3rem;
    line-height: 1.35;
    color: var(--rf-text, #ffffff);
    text-align: right;
    max-width: 16rem;
  }

  .redline-footer-{{ section.id }} .redline-footer__slogan-accent {
    display: block;
    width: 4.8rem;
    height: 3px;
    margin: 0.6rem 0 0 auto;
    background: var(--rf-accent, #e1061d);
    border-radius: 2px;
  }

  .redline-footer-{{ section.id }} .redline-footer__copyright-right > .redline-footer__copyright-item:not(:last-child)::after {
    margin: 0 1.6rem;
  }

  @media screen and (max-width: 989px) {
    .redline-footer-{{ section.id }} .redline-footer__copyright-inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .redline-footer-{{ section.id }} .redline-footer__copyright-right {
      justify-content: flex-start;
      width: 100%;
    }

    .redline-footer-{{ section.id }} .redline-footer__copyright-text,
    .redline-footer-{{ section.id }} .redline-footer__copyright-link {
      white-space: normal;
      font-size: 1.3rem;
    }

    .redline-footer-{{ section.id }} .redline-footer__slogan {
      text-align: left;
    }

    .redline-footer-{{ section.id }} .redline-footer__slogan-accent {
      margin-left: 0;
      margin-right: auto;
    }
  }
{%- endstyle -%}

{%- liquid
  assign has_social_icons = false
  if settings.social_facebook_link != blank or settings.social_instagram_link != blank or settings.social_twitter_link != blank or settings.social_linkedin_link != blank or settings.social_youtube_link != blank or settings.social_tiktok_link != blank or settings.social_pinterest_link != blank or settings.social_snapchat_link != blank or settings.social_tumblr_link != blank or settings.social_vimeo_link != blank
    assign has_social_icons = true
  endif
-%}

<footer class="footer redline-footer redline-footer-{{ section.id }} color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
  <div class="footer__content-top page-width">
    <div class="redline-footer__grid">
      {%- for block in section.blocks -%}
        <div
          class="redline-footer__column redline-footer__column--{{ block.type }}{% if block.type == 'link_list' %} redline-footer__column--menu{% endif %}"
          {{ block.shopify_attributes }}
        >
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}

            {%- when 'brand_information' -%}
              <div class="redline-footer__brand">
                {%- liquid
                  assign footer_logo = block.settings.logo | default: settings.brand_image
                  assign footer_logo_width = block.settings.logo_width | default: settings.brand_image_width | default: 220
                  assign footer_tagline = block.settings.tagline
                  if footer_tagline == blank and settings.brand_description != blank
                    assign footer_tagline = settings.brand_description
                  endif
                -%}

                {%- if footer_logo != blank -%}
                  <div
                    class="redline-footer__logo-wrapper"
                    style="max-width: min(100%, {{ footer_logo_width }}px);"
                  >
                    {{
                      footer_logo
                      | image_url: width: 800
                      | image_tag:
                        class: 'redline-footer__logo',
                        loading: 'lazy',
                        widths: '160, 220, 320, 440, 640, 800',
                        alt: shop.name
                    }}
                  </div>
                {%- elsif settings.brand_headline != blank -%}
                  <h2 class="redline-footer__brand-headline">{{ settings.brand_headline }}</h2>
                {%- else -%}
                  <a href="{{ routes.root_url }}" class="redline-footer__brand-text">
                    Red<span class="redline-footer__brand-divider" aria-hidden="true"></span>Line
                  </a>
                {%- endif -%}

                {%- if footer_tagline != blank -%}
                  <div class="redline-footer__tagline rte">{{ footer_tagline }}</div>
                {%- endif -%}

                {%- if block.settings.show_social and has_social_icons -%}
                  {% render 'redline-social-icons',
                    class: 'redline-footer__social--brand',
                    icon_facebook: section.settings.icon_facebook,
                    icon_twitter: section.settings.icon_twitter,
                    icon_instagram: section.settings.icon_instagram,
                    icon_linkedin: section.settings.icon_linkedin
                  %}
                {%- endif -%}
              </div>

            {%- when 'link_list' -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="redline-footer__heading">{{ block.settings.heading }}</h2>
              {%- endif -%}
              {%- if block.settings.menu != blank -%}
                <ul class="redline-footer__menu list-unstyled">
                  {%- for link in block.settings.menu.links -%}
                    <li>
                      <a
                        href="{{ link.url }}"
                        class="redline-footer__menu-link{% if link.active %} redline-footer__menu-link--active{% endif %}"
                      >
                        {{ link.title | escape }}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}

            {%- when 'visit_us' -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="redline-footer__heading">{{ block.settings.heading }}</h2>
              {%- endif -%}
              <div class="redline-footer__visit">
                {%- if block.settings.location_1 != blank -%}
                  <p class="redline-footer__visit-line">{{ block.settings.location_1 | escape }}</p>
                {%- endif -%}
                {%- if block.settings.location_2 != blank -%}
                  <p class="redline-footer__visit-line">{{ block.settings.location_2 | escape }}</p>
                {%- endif -%}
                {%- if block.settings.show_divider -%}
                  <hr class="redline-footer__divider">
                {%- endif -%}
                {%- if block.settings.support_label != blank or block.settings.support_phones != blank -%}
                  <p class="redline-footer__visit-line">
                    {%- if block.settings.support_label != blank -%}
                      <span class="redline-footer__visit-label">{{ block.settings.support_label | escape }}</span>
                    {%- endif -%}
                    {%- if block.settings.support_phones != blank -%}
                      {%- if block.settings.support_link != blank -%}
                        <a href="{{ block.settings.support_link }}" class="redline-footer__visit-link">
                          {{ block.settings.support_phones | escape }}
                        </a>
                      {%- else -%}
                        {{ block.settings.support_phones | escape }}
                      {%- endif -%}
                    {%- endif -%}
                  </p>
                {%- endif -%}
                {%- if block.settings.aftersales_label != blank or block.settings.aftersales_phones != blank -%}
                  <p class="redline-footer__visit-line">
                    {%- if block.settings.aftersales_label != blank -%}
                      <span class="redline-footer__visit-label">{{ block.settings.aftersales_label | escape }}</span>
                    {%- endif -%}
                    {%- if block.settings.aftersales_phones != blank -%}
                      {%- if block.settings.aftersales_link != blank -%}
                        <a href="{{ block.settings.aftersales_link }}" class="redline-footer__visit-link">
                          {{ block.settings.aftersales_phones | escape }}
                        </a>
                      {%- else -%}
                        {{ block.settings.aftersales_phones | escape }}
                      {%- endif -%}
                    {%- endif -%}
                  </p>
                {%- endif -%}
              </div>

            {%- when 'text' -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="redline-footer__heading">{{ block.settings.heading }}</h2>
              {%- endif -%}
              <div class="redline-footer__text rte">{{ block.settings.subtext }}</div>

            {%- when 'image' -%}
              <div class="redline-footer__image {{ block.settings.alignment }}">
                {%- if block.settings.image != blank -%}
                  {%- assign image_size_2x = block.settings.image_width | times: 2 | at_most: 5760 -%}
                  <div
                    class="redline-footer__image-wrapper"
                    style="max-width: min(100%, {{ block.settings.image_width }}px);"
                  >
                    <img
                      srcset="{{ block.settings.image | image_url: width: block.settings.image_width }}, {{ block.settings.image | image_url: width: image_size_2x }} 2x"
                      src="{{ block.settings.image | image_url: width: 760 }}"
                      alt="{{ block.settings.image.alt | escape }}"
                      loading="lazy"
                      width="{{ block.settings.image.width }}"
                      height="{{ block.settings.image.height }}"
                    >
                  </div>
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
                {%- endif -%}
              </div>
          {%- endcase -%}
        </div>
      {%- endfor -%}

      {%- if section.settings.newsletter_enable -%}
        <div class="redline-footer__column redline-footer__column--newsletter">
          <div class="redline-footer__newsletter-panel">
            {%- if section.settings.newsletter_heading != blank -%}
              <h2 class="redline-footer__newsletter-heading">{{ section.settings.newsletter_heading }}</h2>
            {%- endif -%}
            {%- if section.settings.newsletter_subtext != blank -%}
              <p class="redline-footer__newsletter-subtext">{{ section.settings.newsletter_subtext | escape }}</p>
            {%- endif -%}

            {%- form 'customer', id: 'ContactFooter', class: 'redline-footer__newsletter-form' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <div class="redline-footer__newsletter-field">
                <label class="visually-hidden" for="NewsletterForm--{{ section.id }}">
                  {{ section.settings.newsletter_placeholder | default: 'Enter your email address' }}
                </label>
                <input
                  id="NewsletterForm--{{ section.id }}"
                  type="email"
                  name="contact[email]"
                  class="redline-footer__newsletter-input"
                  value="{{ form.email }}"
                  aria-required="true"
                  autocorrect="off"
                  autocapitalize="off"
                  autocomplete="email"
                  placeholder="{{ section.settings.newsletter_placeholder | default: 'Enter your email address' | escape }}"
                  required
                  {% if form.errors %}
                    autofocus
                    aria-invalid="true"
                    aria-describedby="ContactFooter-error"
                  {% elsif form.posted_successfully? %}
                    aria-describedby="ContactFooter-success"
                  {% endif %}
                >
                <button
                  type="submit"
                  class="redline-footer__newsletter-submit"
                  name="commit"
                  id="Subscribe"
                  aria-label="{{ 'newsletter.button_label' | t }}"
                >
                  {%- if section.settings.newsletter_button_icon != blank -%}
                    {{
                      section.settings.newsletter_button_icon
                      | image_url: width: 48
                      | image_tag: class: 'redline-footer__newsletter-submit-icon', loading: 'lazy', alt: ''
                    }}
                  {%- else -%}
                    <span class="svg-wrapper">{{- 'icon-search.svg' | inline_asset_content -}}</span>
                  {%- endif -%}
                </button>
              </div>

              {%- if form.errors -%}
                <small class="newsletter-form__message form__message" id="ContactFooter-error">
                  {{- form.errors.translated_fields.email | capitalize }}
                  {{ form.errors.messages.email -}}
                </small>
              {%- endif -%}

              {%- if form.posted_successfully? -%}
                <h3
                  class="newsletter-form__message newsletter-form__message--success form__message"
                  id="ContactFooter-success"
                  tabindex="-1"
                  autofocus
                >
                  {{- 'newsletter.success' | t }}
                </h3>
              {%- endif -%}
            {%- endform -%}
          </div>
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.show_social and has_social_icons -%}
      {%- assign brand_block_shows_social = false -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'brand_information' and block.settings.show_social -%}
          {%- assign brand_block_shows_social = true -%}
        {%- endif -%}
      {%- endfor -%}
      {%- unless brand_block_shows_social -%}
        {% render 'redline-social-icons',
          class: 'redline-footer__social--standalone',
          icon_facebook: section.settings.icon_facebook,
          icon_twitter: section.settings.icon_twitter,
          icon_instagram: section.settings.icon_instagram,
          icon_linkedin: section.settings.icon_linkedin
        %}
      {%- endunless -%}
    {%- endif -%}

    {%- if shop.features.follow_on_shop? and section.settings.enable_follow_on_shop -%}
      <div class="footer__follow-on-shop">
        {{ shop | login_button: action: 'follow' }}
      </div>
    {%- endif -%}
  </div>

  <div class="redline-footer__copyright">
    <div class="redline-footer__copyright-inner page-width">
      <ul class="redline-footer__copyright-left" role="list">
        <li class="redline-footer__copyright-item">
          <span class="redline-footer__copyright-text">
            {%- if section.settings.copyright_text != blank -%}
              {{ section.settings.copyright_text | escape }}
            {%- else -%}
              &copy; {{ 'now' | date: '%Y' }} Redline Mauritius. All rights reserved.
            {%- endif -%}
          </span>
        </li>

        {%- if section.settings.copyright_menu != blank -%}
          {%- for link in section.settings.copyright_menu.links -%}
            <li class="redline-footer__copyright-item">
              <a href="{{ link.url }}" class="redline-footer__copyright-link">{{ link.title | escape }}</a>
            </li>
          {%- endfor -%}
        {%- elsif section.settings.show_policy -%}
          {%- for policy in shop.policies -%}
            {%- if policy != blank -%}
              <li class="redline-footer__copyright-item">
                <a href="{{ policy.url }}" class="redline-footer__copyright-link">{{ policy.title | escape }}</a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </ul>

      <ul class="redline-footer__copyright-right" role="list">
        {%- if section.settings.payment_enable -%}
          <li class="redline-footer__copyright-item">
            <span class="visually-hidden">{{ 'sections.footer.payment' | t }}</span>
            <ul class="redline-footer__payments" role="list">
              {%- for type in shop.enabled_payment_types -%}
                <li class="redline-footer__payment-item">
                  {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                </li>
              {%- endfor -%}
              {%- if section.settings.payment_icon_extra != blank -%}
                <li class="redline-footer__payment-item">
                  {%- assign extra_payment_alt = section.settings.payment_icon_extra.alt | default: 'Payment' -%}
                  {{
                    section.settings.payment_icon_extra
                    | image_url: width: 120
                    | image_tag: class: 'redline-footer__payment-image', loading: 'lazy', alt: extra_payment_alt
                  }}
                </li>
              {%- endif -%}
            </ul>
          </li>
        {%- endif -%}

        {%- if section.settings.copyright_slogan != blank -%}
          <li class="redline-footer__copyright-item">
            <p class="redline-footer__slogan">
              {{ section.settings.copyright_slogan | newline_to_br }}
              {%- if section.settings.show_slogan_accent -%}
                <span class="redline-footer__slogan-accent" aria-hidden="true"></span>
              {%- endif -%}
            </p>
          </li>
        {%- endif -%}
      </ul>
    </div>

    {%- if section.settings.enable_country_selector and localization.available_countries.size > 1
      or section.settings.enable_language_selector and localization.available_languages.size > 1
    -%}
      <div class="footer__content-bottom-wrapper page-width" style="padding-top: 1.2rem;">
        <div class="footer__column footer__localization isolate">
          {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
            <localization-form>
              {%- form 'localization', id: 'FooterCountryForm', class: 'localization-form' -%}
                <div>
                  <h2 class="caption-large text-body" id="FooterCountryLabel">{{ 'localization.country_label' | t }}</h2>
                  {%- render 'country-localization', localPosition: 'FooterCountry' -%}
                </div>
              {%- endform -%}
            </localization-form>
          {%- endif -%}

          {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
            <localization-form>
              {%- form 'localization', id: 'FooterLanguageForm', class: 'localization-form' -%}
                <div>
                  <h2 class="caption-large text-body" id="FooterLanguageLabel">
                    {{ 'localization.language_label' | t }}
                  </h2>
                  {%- render 'language-localization', localPosition: 'FooterLanguage' -%}
                </div>
              {%- endform -%}
            </localization-form>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "brand_information",
      "name": "t:sections.footer.blocks.brand_information.name",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Uses Theme settings → Brand information when logo/tagline fields below are empty. Social URLs use Theme settings → Social media."
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Footer logo",
          "info": "Optional override of Brand information image"
        },
        {
          "type": "range",
          "id": "logo_width",
          "min": 80,
          "max": 400,
          "step": 10,
          "unit": "px",
          "label": "Logo width",
          "default": 220
        },
        {
          "type": "richtext",
          "id": "tagline",
          "label": "Tagline",
          "default": "<p>Technology and home essentials, carefully selected for Mauritius.</p>",
          "info": "Leave blank to use Brand information description"
        },
        {
          "type": "checkbox",
          "id": "show_social",
          "default": true,
          "label": "t:sections.footer.blocks.brand_information.settings.show_social.label",
          "info": "t:sections.footer.blocks.brand_information.settings.show_social.info"
        }
      ]
    },
    {
      "type": "link_list",
      "name": "t:sections.footer.blocks.link_list.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "t:sections.footer.blocks.link_list.settings.heading.default",
          "label": "t:sections.footer.blocks.link_list.settings.heading.label"
        },
        {
          "type": "link_list",
          "id": "menu",
          "default": "footer",
          "label": "t:sections.footer.blocks.link_list.settings.menu.label",
          "info": "Create and edit menus in Shopify admin → Navigation"
        }
      ]
    },
    {
      "type": "visit_us",
      "name": "Visit Us",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading",
          "default": "Visit Us"
        },
        {
          "type": "text",
          "id": "location_1",
          "label": "Location 1",
          "default": "Bagatelle Motor City"
        },
        {
          "type": "text",
          "id": "location_2",
          "label": "Location 2",
          "default": "Grand Baie – Chemin Vingt Pieds"
        },
        {
          "type": "checkbox",
          "id": "show_divider",
          "label": "Show divider",
          "default": true
        },
        {
          "type": "text",
          "id": "support_label",
          "label": "Support label",
          "default": "Customer Support:"
        },
        {
          "type": "text",
          "id": "support_phones",
          "label": "Support phones",
          "default": "5250 2503 / 211 6060"
        },
        {
          "type": "url",
