{%- comment -%}
   Needs assets: rl-base.css, rl-collection.css, rl-collection.js
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign rl_show_section = true
  if request.page_type == 'collection' and collection.handle != 'all'
    assign rl_show_section = false
  endif
-%}

{%- if rl_show_section -%}
  {{ 'rl-base.css' | asset_url | stylesheet_tag }}
  {{ 'rl-collection.css' | asset_url | stylesheet_tag }}

  <section
    class="rl-section rl-collection{% if s.bleed %} rl-collection--bleed{% endif %}"
    data-rl-collection
    {% if s.autoplay %}data-cl-autoplay="{{ s.autoplay_speed }}"{% endif %}
    style="--rl-accent:{{ s.accent_color }};--rl-heading:{{ s.heading_color }};--rl-bg:{{ s.section_bg }};--rl-maxw:{{ s.max_width }}px;--rl-pt:{{ s.padding_top }}px;--rl-pb:{{ s.padding_bottom }}px;--cl-tile:{{ s.tile_bg }};--cl-radius:{{ s.radius }}px;--cl-gap:{{ s.gap }}px;--cl-img:{{ s.image_height }}px;--cl-pv-d:{{ s.tiles_desktop }};--cl-pv-t:{{ s.tiles_tablet }};--cl-pv-m:{{ s.tiles_mobile }};--cl-heading-size:{{ s.heading_size }}px;"
  >
    <div class="rl-container shop_by_catagory">
      <div class="rl-head rl-collection__head">
        <div class="explore_range">
          {%- if s.eyebrow != blank -%}<p class="rl-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
          {%- if s.heading != blank -%}
            <h2 class="rl-header" style="font-size: {{ s.heading_size }}px; color: {{ s.heading_color }};">{{ s.heading }}</h2>
          {%- endif -%}
        </div>
        {%- if request.page_type != 'collection' and s.link_text != blank and s.link_url != blank -%}
          <a class="rl-link rl-collection__link" href="{{ s.link_url }}">{{ s.link_text }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="rl-collection__wrap">
          {%- if s.show_arrows -%}
            <button type="button" class="rl-collection__arrow rl-collection__arrow--prev" data-cl-prev aria-label="Previous categories"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
            <button type="button" class="rl-collection__arrow rl-collection__arrow--next" data-cl-next aria-label="Next categories"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
          {%- endif -%}

          <ul class="rl-collection__scroller" role="list">
            {%- for block in section.blocks -%}
              {%- liquid
                assign b = block.settings
                assign col = b.collection
                assign name = b.name | default: col.title
                assign url = b.link
                if url == blank and col != blank
                  assign url = col.url
                endif
                assign img = b.image
                if img == blank and col != blank
                  assign img = col.featured_image
                endif
              -%}
              <li class="rl-collection__item" {{ block.shopify_attributes }}>
                {%- capture tile -%}
                  <span class="rl-collection__media">
                    {%- if img != blank -%}
                      {{ img | image_url: width: 400 | image_tag: loading: 'lazy', widths: '160, 240, 320, 400', sizes: '(min-width: 990px) 15vw, 40vw', alt: name }}
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag }}
                    {%- endif -%}
                  </span>
                  <span class="rl-collection__name">{{ name | default: 'Category' }}</span>
                {%- endcapture -%}
                {%- if url != blank -%}
                  <a class="rl-collection__tile" href="{{ url }}" draggable="false">{{ tile }}</a>
                {%- else -%}
                  <div class="rl-collection__tile rl-collection__tile--nolink">{{ tile }}</div>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>

        {%- if s.show_dots -%}
          <div class="rl-collection__dots" data-cl-dots role="tablist" aria-label="Category slides"></div>
        {%- endif -%}
      {%- elsif request.design_mode -%}
        <p>Add “Category” blocks.</p>
      {%- endif -%}
    </div>
  </section>

  <script src="{{ 'rl-collection.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "RL Categories",
  "tag": "div",
  "class": "section-rl-collection",
  "max_blocks": 16,
  "settings": [
    { "type": "header", "content": "1. Heading" },
    { "type": "text", "id": "eyebrow", "label": "Small title", "default": "Explore Our Range" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop By Category" },
    { "type": "range", "id": "heading_size", "label": "Heading font size", "min": 20, "max": 52, "step": 2, "unit": "px", "default": 32 },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#1a1a1a" },
    { "type": "text", "id": "link_text", "label": "Link text", "default": "View all categories" },
    { "type": "url", "id": "link_url", "label": "Link", "info": "Hidden if empty." },

    { "type": "header", "content": "2. Layout" },
    { "type": "select", "id": "tiles_desktop", "label": "Tiles visible on desktop", "options": [
      { "value": "4", "label": "4" },
      { "value": "5", "label": "5" },
      { "value": "6", "label": "6" },
      { "value": "7", "label": "7" },
      { "value": "8", "label": "8" },
      { "value": "9", "label": "9" },
      { "value": "10", "label": "10" }
    ], "default": "6" },
    { "type": "select", "id": "tiles_tablet", "label": "Tiles visible on tablet", "options": [ { "value": "3", "label": "3" }, { "value": "4", "label": "4" } ], "default": "4" },
    { "type": "select", "id": "tiles_mobile", "label": "Tiles visible on mobile", "options": [ { "value": "2", "label": "2" }, { "value": "2.5", "label": "2.5" }, { "value": "3", "label": "3" } ], "default": "2" },
    { "type": "range", "id": "image_height", "label": "Image area height", "min": 100, "max": 260, "step": 10, "unit": "px", "default": 170 },
    { "type": "range", "id": "gap", "label": "Space between tiles", "min": 8, "max": 32, "step": 2, "unit": "px", "default": 14 },
    { "type": "range", "id": "radius", "label": "Rounded corners", "min": 0, "max": 20, "step": 2, "unit": "px", "default": 8 },
    { "type": "checkbox", "id": "bleed", "label": "Let the row run to the screen edge", "default": false, "info": "Keep off for a normal slider inside the container (6 tiles, side padding)." },
    { "type": "range", "id": "max_width", "label": "Content max width", "min": 900, "max": 1800, "step": 20, "unit": "px", "default": 1400 },

    { "type": "header", "content": "3. Slider controls" },
    { "type": "checkbox", "id": "show_arrows", "label": "Show arrow buttons (desktop)", "default": true },
    { "type": "checkbox", "id": "show_dots", "label": "Show dots", "default": false },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay", "default": false },
    { "type": "range", "id": "autoplay_speed", "label": "Autoplay speed", "min": 2, "max": 10, "step": 1, "unit": "s", "default": 4, "info": "Only used when Autoplay is on." },

    { "type": "header", "content": "4. Colors" },
    { "type": "color", "id": "accent_color", "label": "Accent (red)", "default": "#d0021b" },
    { "type": "color", "id": "tile_bg", "label": "Tile background", "default": "#f3f3f0" },
    { "type": "color", "id": "section_bg", "label": "Section background", "default": "#ffffff" },

    { "type": "header", "content": "5. Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top space", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom space", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection", "info": "Makes the tile clickable and fills name, link and image automatically." },
        { "type": "text", "id": "name", "label": "Name (optional)", "info": "Overrides the collection name." },
        { "type": "url", "id": "link", "label": "Link (optional)", "info": "Overrides the collection link. Required for click if no collection is selected." },
        { "type": "image_picker", "id": "image", "label": "Image (optional)", "info": "Product photo on a transparent or white background. Overrides the collection image." }
      ]
    }
  ],
  "presets": [
    {
      "name": "RL Categories",
      "blocks": [
        { "type": "category", "settings": { "name": "Refrigeration" } },
        { "type": "category", "settings": { "name": "Laundry" } },
        { "type": "category", "settings": { "name": "Small Appliances" } },
        { "type": "category", "settings": { "name": "TV & Audio" } },
        { "type": "category", "settings": { "name": "Built-in Kitchen" } },
        { "type": "category", "settings": { "name": "Air Conditioning" } },
        { "type": "category", "settings": { "name": "Kitchen Appliances" } }
      ]
    }
  ]
}
{% endschema %}
