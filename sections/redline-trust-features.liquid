<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600&display=swap" rel="stylesheet">

{%- style -%}
  .redline-trust-{{ section.id }} {
    --rt-bg: {{ section.settings.background_color | default: '#1A1E21' }};
    --rt-title: {{ section.settings.title_color | default: '#FFFFFF' }};
    --rt-text: {{ section.settings.text_color | default: '#B8B8B8' }};
    --rt-divider: {{ section.settings.divider_color | default: '#3A3F44' }};
    background: var(--rt-bg);
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .redline-trust-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .redline-trust-{{ section.id }} .redline-trust__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .redline-trust-{{ section.id }} .redline-trust__item {
    display: flex;
    align-items: flex-start;
    gap: 1.4rem;
    min-width: 0;
  }

  .redline-trust-{{ section.id }} .redline-trust__icon {
    flex: 0 0 auto;
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .redline-trust-{{ section.id }} .redline-trust__icon img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .redline-trust-{{ section.id }} .redline-trust__icon-placeholder {
    width: 100%;
    height: 100%;
    border: 1px dashed rgba(255, 255, 255, 0.25);
    border-radius: 0.6rem;
  }

  .redline-trust-{{ section.id }} .redline-trust__content {
    flex: 1 1 auto;
    min-width: 0;
  }

  .redline-trust-{{ section.id }} .redline-trust__title {
    margin: 0 0 0.4rem;
    font-family: 'Manrope', sans-serif;
    font-weight: 600;
    font-size: 1.6rem;
    line-height: 1.3;
    letter-spacing: 0;
    text-transform: capitalize;
    color: var(--rt-title);
  }

  .redline-trust-{{ section.id }} .redline-trust__description {
    margin: 0;
    font-family: 'Manrope', sans-serif;
    font-weight: 500;
    font-size: 1.4rem;
    line-height: 1.4;
    letter-spacing: 0;
    color: var(--rt-text);
  }

  @media screen and (min-width: 750px) {
    .redline-trust-{{ section.id }} .redline-trust__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.8rem 0;
    }

    .redline-trust-{{ section.id }} .redline-trust__item {
      padding: 0 2rem;
      position: relative;
    }

    .redline-trust-{{ section.id }} .redline-trust__item:nth-child(odd) {
      padding-left: 0;
    }

    .redline-trust-{{ section.id }} .redline-trust__item:nth-child(even) {
      padding-right: 0;
    }

    .redline-trust-{{ section.id }} .redline-trust__item:nth-child(odd)::after {
      content: '';
      position: absolute;
      top: 0.2rem;
      right: 0;
      bottom: 0.2rem;
      width: 1px;
      background: var(--rt-divider);
    }
  }

  @media screen and (min-width: 990px) {
    .redline-trust-{{ section.id }} .redline-trust__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0;
      align-items: start;
    }

    .redline-trust-{{ section.id }} .redline-trust__item {
      padding: 0 2.4rem;
    }

    .redline-trust-{{ section.id }} .redline-trust__item:first-child {
      padding-left: 0;
    }

    .redline-trust-{{ section.id }} .redline-trust__item:last-child {
      padding-right: 0;
    }

    .redline-trust-{{ section.id }} .redline-trust__item::after {
      content: '';
      position: absolute;
      top: 0.2rem;
      right: 0;
      bottom: 0.2rem;
      width: 1px;
      background: var(--rt-divider);
    }

    .redline-trust-{{ section.id }} .redline-trust__item:last-child::after {
      display: none;
    }

    .redline-trust-{{ section.id }} .redline-trust__item:nth-child(odd)::after {
      display: block;
    }
  }
{%- endstyle -%}

<div class="redline-trust redline-trust-{{ section.id }}">
  <div class="page-width">
    {%- if section.blocks.size > 0 -%}
      <ul class="redline-trust__grid" role="list">
        {%- for block in section.blocks -%}
          <li class="redline-trust__item" {{ block.shopify_attributes }}>
            <div class="redline-trust__icon">
              {%- if block.settings.image != blank -%}
                {%- assign feature_alt = block.settings.image.alt | default: block.settings.title -%}
                {{
                  block.settings.image
                  | image_url: width: 160
                  | image_tag:
                    loading: 'lazy',
                    widths: '48, 64, 80, 96, 128, 160',
                    alt: feature_alt
                }}
              {%- else -%}
                <span class="redline-trust__icon-placeholder" aria-hidden="true"></span>
              {%- endif -%}
            </div>
            <div class="redline-trust__content">
              {%- if block.settings.title != blank -%}
                <h3 class="redline-trust__title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="redline-trust__description">{{ block.settings.description | escape }}</p>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Trust features",
  "tag": "section",
  "class": "section-redline-trust",
  "max_blocks": 4,
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#1A1E21"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Description color",
      "default": "#B8B8B8"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "default": "#3A3F44"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 32,
      "max": 72,
      "step": 4,
      "unit": "px",
      "label": "Icon size",
      "default": 48
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Secure Payments"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Your information is always protected"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust features",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "title": "Secure Payments",
            "description": "Your information is always protected"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Free Delivery on Selected Products",
            "description": "Across Mauritius"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Official Brand Warranty",
            "description": "Genuine products, local support"
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Dedicated After-Sales Support",
            "description": "Here when you need us"
          }
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["footer", "header"],
    "templates": ["*"]
  }
}
{% endschema %}
