{%- comment -%}
  rl-category-cards — image cards with title + arrow (e.g. "We Are Ooni Pizza Ovens"). Pure CSS, no JavaScript.
  Needs assets: rl-base.css, rl-category-cards.css
  Each card is a block. Easiest way: pick a Collection — title, image and link fill in automatically.
  Anything you type or upload in the block overrides the collection's own data.
{%- endcomment -%}
{{ 'rl-base.css' | asset_url | stylesheet_tag }}
{{ 'rl-category-cards.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
{%- assign ov = s.overlay | divided_by: 100.0 -%}
{%- case s.image_shape -%}
  {%- when 'square' -%}
    {%- assign ratio = '1 / 1' -%}
  {%- when 'portrait' -%}
    {%- assign ratio = '4 / 5' -%}
  {%- when 'wide' -%}
    {%- assign ratio = '16 / 10' -%}
  {%- else -%}
    {%- assign ratio = '5 / 4' -%}
{%- endcase -%}

<section
  class="rl-section rl-cats{% if s.title_position == 'bottom' %} rl-cats--bottom{% endif %}{% unless s.show_arrow %} rl-cats--noarrow{% endunless %}{% if s.mobile_swipe %} rl-cats--swipe{% endif %}"
  style="--rl-accent:{{ s.accent_color }};--rl-heading:{{ s.heading_color }};--rl-bg:{{ s.section_bg }};--rl-maxw:{{ s.max_width }}px;--rl-pt:{{ s.padding_top }}px;--rl-pb:{{ s.padding_bottom }}px;--cols-d:{{ s.cols_desktop }};--cols-t:{{ s.cols_tablet }};--cols-m:{{ s.cols_mobile }};--cat-gap:{{ s.gap }}px;--cat-radius:{{ s.radius }}px;--cat-ratio:{{ ratio }};--cat-ov:{{ ov }};"
>
  <div class="rl-container">
    <div class="rl-head">
      <div>
        {%- if s.eyebrow != blank -%}
          <p class="rl-eyebrow">{{ s.eyebrow }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="rl-heading">{{ s.heading }}</h2>
        {%- endif -%}
      </div>
      {%- if s.link_text != blank and s.link_url != blank -%}
        <a class="rl-link" href="{{ s.link_url }}">
          {{- s.link_text }}
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 6l6 6-6 6"/>
          </svg>
        </a>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="rl-cats__grid" role="list">
        {%- for block in section.blocks -%}
          {%- assign col = block.settings.collection -%}
          {%- assign card_title = block.settings.title | default: col.title -%}
          {%- assign card_url = block.settings.link | default: col.url -%}
          {%- assign card_img = block.settings.image | default: col.featured_image -%}

          {%- capture inner -%}
            <span class="rl-cats__media">
              {%- if card_img != blank -%}
                {{ card_img | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 90vw', alt: card_title }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag }}
              {%- endif -%}
            </span>
            <span class="rl-cats__bar">
              <span class="rl-cats__title">{{ card_title | default: 'Card title' }}</span>
              <span class="rl-cats__arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
            </span>
          {%- endcapture -%}

          <li class="rl-cats__item" {{ block.shopify_attributes }}>
            {%- if card_url != blank -%}
              <a class="rl-cats__card" href="{{ card_url }}">{{ inner }}</a>
            {%- else -%}
              <div class="rl-cats__card">{{ inner }}</div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "RL Category cards",
  "tag": "div",
  "class": "section-rl-category-cards",
  "settings": [
    { "type": "header", "content": "1. Heading" },
    { "type": "text", "id": "eyebrow", "label": "Small title", "default": "Outdoor Living" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We Are Ooni Pizza Ovens" },
    { "type": "text", "id": "link_text", "label": "Link text", "default": "Explore More" },
    { "type": "url", "id": "link_url", "label": "Link", "info": "Hidden if empty." },

    { "type": "header", "content": "2. Layout" },
    {
      "type": "range",
      "id": "cols_desktop",
      "label": "Cards per row (desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "cols_tablet",
      "label": "Cards per row (tablet)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
  "type": "select",
  "id": "cols_mobile",
  "label": "Cards per row (mobile)",
  "options": [
    {
      "value": "1",
      "label": "1 card"
    },
    {
      "value": "2",
      "label": "2 cards"
    }
  ],
  "default": "1"
},
    { "type": "checkbox", "id": "mobile_swipe", "label": "Mobile: single row you can swipe", "default": false },
    {
      "type": "select",
      "id": "image_shape",
      "label": "Card shape",
      "options": [
        { "value": "landscape", "label": "Landscape (as in design)" },
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "wide", "label": "Wide" }
      ],
      "default": "landscape"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Space between cards",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Rounded corners",
      "min": 0,
      "max": 28,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Content max width",
      "min": 900,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1240
    },

    { "type": "header", "content": "3. Card style" },
    {
      "type": "select",
      "id": "title_position",
      "label": "Title position",
      "options": [
        { "value": "top", "label": "Top (as in design)" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "top"
    },
    { "type": "checkbox", "id": "show_arrow", "label": "Show round arrow", "default": true },
    {
      "type": "range",
      "id": "overlay",
      "label": "Dark fade behind title",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 45,
      "info": "Keeps the white title readable on bright photos."
    },

    { "type": "header", "content": "4. Colors" },
    { "type": "color", "id": "accent_color", "label": "Small title & link", "default": "#d0021b" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#1a1a1a" },
    { "type": "color", "id": "section_bg", "label": "Section background", "default": "#ffffff" },

    { "type": "header", "content": "5. Spacing" },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top space",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom space",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection (easiest)",
          "info": "Title, image and link fill in automatically. Anything below overrides it."
        },
        { "type": "text", "id": "title", "label": "Title", "info": "Empty = collection name." },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Empty = collection image." },
        { "type": "url", "id": "link", "label": "Link", "info": "Empty = collection page." }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "RL Category cards",
      "blocks": [
        { "type": "card", "settings": { "title": "Pizza Accessories" } },
        { "type": "card", "settings": { "title": "Pizza Ovens" } },
        { "type": "card", "settings": { "title": "Outdoor Cookware" } },
        { "type": "card", "settings": { "title": "Grills & BBQ Essentials" } }
      ]
    }
  ]
}
{% endschema %}
