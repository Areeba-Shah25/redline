{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
{{ 'rl-product-card.css' | asset_url | stylesheet_tag }}
{{ 'rl-product-card-list.css' | asset_url | stylesheet_tag }}
{{ 'rl-collection-views.css' | asset_url | stylesheet_tag }}
<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'rl-collection-views.js' | asset_url }}" defer="defer"></script>

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- comment -%}
  Redline collection: filters left + products right.
  layout_options: both (toggle) | grid | list — default both.
{%- endcomment -%}
{%- liquid
  assign rl_filter_type = 'vertical'
  assign rl_layout = section.settings.layout_options | default: 'both'
  assign rl_show_grid = false
  assign rl_show_list = false
  assign rl_show_toggle = false
  if rl_layout == 'grid'
    assign rl_show_grid = true
    assign rl_active_view = 'grid'
  elsif rl_layout == 'list'
    assign rl_show_list = true
    assign rl_active_view = 'list'
  else
    assign rl_show_grid = true
    assign rl_show_list = true
    assign rl_show_toggle = true
    assign rl_active_view = section.settings.default_view | default: 'grid'
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<collection-component
  view-event-payload="{{ collection | standard_event_data: 'view' | escape }}"
  data-collection-id="{{ collection.id }}"
>
  <div class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}">
    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- assign rl_is_empty = false -%}
      {%- if collection.products_count == 0 -%}
        {%- assign rl_is_empty = true -%}
      {%- endif -%}
      <div
        class="page-width rl-cview-page{% if section.settings.sticky_filters %} rl-cview-page--sticky-filters{% endif %}{% if rl_is_empty %} rl-cview-page--empty{% endif %}"
        data-rl-cview
        data-rl-layout="{{ rl_layout }}"
        data-rl-default-view="{{ rl_active_view }}"
        data-rl-empty="{% if rl_is_empty %}true{% else %}false{% endif %}"
        style="--rl-cols-desktop: {{ section.settings.columns_desktop }}; --rl-cols-mobile: {{ section.settings.columns_mobile }};"
      >
        <div class="rl-cview">
          <p class="rl-cview__count">
            <span
              id="ProductCountDesktop"
              data-product-count="{{ collection.products_count }}"
            >
              {%- if collection.products_count == collection.all_products_count -%}
                <strong>{{ collection.products_count }} {% if collection.products_count == 1 %}product{% else %}products{% endif %}</strong>
                in the {{ collection.title | downcase }} collection
              {%- else -%}
                <strong>{{ collection.products_count }} of {{ collection.all_products_count }}</strong>
                products
              {%- endif -%}
            </span>
          </p>
          <div class="rl-cview__tools">
            {%- if section.settings.enable_filtering -%}
              <button
                type="button"
                class="rl-cview__filters-btn"
                data-rl-cview-filters
                aria-expanded="true"
                aria-controls="main-collection-filters"
                {% if rl_is_empty %}disabled aria-disabled="true"{% endif %}
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M2 4h12M4 8h8M6 12h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
                Filters
              </button>
            {%- endif -%}
            {%- if section.settings.enable_sorting -%}
              {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
              {%- assign sort_label = '' -%}
              {%- for option in collection.sort_options -%}
                {%- if option.value == sort_by -%}
                  {%- assign sort_label = option.name -%}
                {%- endif -%}
              {%- endfor -%}
              {%- if sort_label == blank and collection.sort_options.size > 0 -%}
                {%- assign sort_label = collection.sort_options.first.name -%}
              {%- endif -%}
              <facet-filters-form class="facets rl-cview__sort small-hide feature_sorting">
                <form class="rl-cview__sort-form" id="FacetSortForm" data-rl-sort>
                  <label class="rl-cview__sort-label" id="SortByLabel" for="SortBy">
                    {{- 'products.facets.sort_by_label' | t -}}
                  </label>
                  <select
                    name="sort_by"
                    class="rl-cview__sort-select rl-cview__sort-select--native"
                    id="SortBy"
                    aria-describedby="a11y-refresh-page-message"
                    tabindex="-1"
                    aria-hidden="true"
                    {% if rl_is_empty %}disabled{% endif %}
                  >
                    {%- for option in collection.sort_options -%}
                      <option
                        value="{{ option.value | escape }}"
                        {% if option.value == sort_by %}
                          selected="selected"
                        {% endif %}
                      >
                        {{ option.name | escape }}
                      </option>
                    {%- endfor -%}
                  </select>
                  <div class="rl-cview__dd">
                    <button
                      type="button"
                      class="rl-cview__dd-btn"
                      data-rl-sort-toggle
                      aria-haspopup="listbox"
                      aria-expanded="false"
                      aria-labelledby="SortByLabel SortByValue"
                      {% if rl_is_empty %}disabled aria-disabled="true"{% endif %}
                    >
                      <span class="rl-cview__dd-value" id="SortByValue" data-rl-sort-value>{{ sort_label | escape }}</span>
                      <svg class="rl-cview__dd-caret" xmlns="http://www.w3.org/2000/svg" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                        <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round"/>
                      </svg>
                    </button>
                    <ul class="rl-cview__dd-menu" role="listbox" data-rl-sort-menu hidden>
                      {%- for option in collection.sort_options -%}
                        <li role="option">
                          <button
                            type="button"
                            class="rl-cview__dd-option{% if option.value == sort_by %} is-selected{% endif %}"
                            data-rl-sort-option
                            data-value="{{ option.value | escape }}"
                            {% if option.value == sort_by %}
                              aria-selected="true"
                            {% else %}
                              aria-selected="false"
                            {% endif %}
                          >
                            {{ option.name | escape }}
                          </button>
                        </li>
                      {%- endfor -%}
                    </ul>
                  </div>
                </form>
              </facet-filters-form>
            {%- endif -%}
            {%- if rl_show_toggle -%}
              <div class="rl-cview__cols" role="group" aria-label="Product layout">
                <button
                  type="button"
                  class="rl-cview__col"
                  data-rl-cview-mode="grid"
                  aria-pressed="{% if rl_active_view == 'grid' %}true{% else %}false{% endif %}"
                  aria-label="Grid view"
                  {% if rl_is_empty %}disabled aria-disabled="true"{% endif %}
                >
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                    <rect x="2" y="2" width="6" height="6" rx="1" stroke="currentColor" stroke-width="1.5"/>
                    <rect x="10" y="2" width="6" height="6" rx="1" stroke="currentColor" stroke-width="1.5"/>
                    <rect x="2" y="10" width="6" height="6" rx="1" stroke="currentColor" stroke-width="1.5"/>
                    <rect x="10" y="10" width="6" height="6" rx="1" stroke="currentColor" stroke-width="1.5"/>
                  </svg>
                </button>
                <button
                  type="button"
                  class="rl-cview__col"
                  data-rl-cview-mode="list"
                  aria-pressed="{% if rl_active_view == 'list' %}true{% else %}false{% endif %}"
                  aria-label="List view"
                  {% if rl_is_empty %}disabled aria-disabled="true"{% endif %}
                >
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                    <rect x="2" y="3" width="14" height="2.5" rx="0.5" fill="currentColor"/>
                    <rect x="2" y="7.75" width="14" height="2.5" rx="0.5" fill="currentColor"/>
                    <rect x="2" y="12.5" width="14" height="2.5" rx="0.5" fill="currentColor"/>
                  </svg>
                </button>
              </div>
            {%- endif -%}
          </div>
        </div>

        <div class="facets-vertical rl-cview-layout">
          {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
            <aside
              aria-labelledby="verticalTitle"
              class="facets-wrapper{% unless section.settings.enable_filtering %} facets-wrapper--no-filters{% endunless %}"
              id="main-collection-filters"
              data-id="{{ section.id }}"
              data-rl-cview-side
            >
              {% render 'facets',
                results: collection,
                enable_filtering: section.settings.enable_filtering,
                enable_sorting: false,
                filter_type: rl_filter_type,
                paginate: paginate
              %}
            </aside>
          {%- endif -%}

          <div
            class="product-grid-container{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            id="ProductGridContainer"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
            {% endif %}
          >
            {%- if collection.products.size == 0 -%}
              <div
                class="collection collection--empty rl-cview-empty"
                id="product-grid"
                data-id="{{ section.id }}"
              >
                <div class="rl-cview-empty__inner">
                  <h2 class="rl-cview-empty__title">
                    {{ 'sections.collection_template.empty' | t }}
                  </h2>
                  <p class="rl-cview-empty__text">
                    <a class="underlined-link link" href="{{ routes.all_products_collection_url }}">
                      Go to the Shop page
                    </a>
                  </p>
                </div>
              </div>
            {%- else -%}
              <div class="collection">
                <div class="loading-overlay gradient"></div>

                <ul
                  id="product-grid"
                  data-id="{{ section.id }}"
                  data-rl-cview-grid
                  data-rl-view="{{ rl_active_view }}"
                  class="rl-cview-grid"
                >
                  {%- for product in collection.products -%}
                    <li
                      class="rl-cview-item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                      {% if settings.animations_reveal_on_scroll %}
                        data-cascade
                        style="--animation-order: {{ forloop.index }};"
                      {% endif %}
                    >
                      {%- if rl_show_grid -%}
                        <div class="rl-cview-item__grid">
                          {% render 'rl-product-card',
                            product: product,
                            show_vendor: section.settings.show_vendor,
                            show_rating: section.settings.show_rating,
                            image_ratio: section.settings.image_ratio,
                            image_shape: section.settings.image_shape,
                            show_secondary_image: section.settings.show_secondary_image,
                            badge_style: section.settings.badge_style,
                            badge_text: section.settings.badge_text,
                            button_label: section.settings.button_label,
                            strike: true
                          %}
                        </div>
                      {%- endif -%}
                      {%- if rl_show_list -%}
                        <div class="rl-cview-item__list">
                          {% render 'rl-product-card-list',
                            product: product,
                            show_vendor: section.settings.show_vendor,
                            show_rating: section.settings.show_rating,
                            image_ratio: section.settings.image_ratio,
                            image_shape: section.settings.image_shape,
                            show_secondary_image: section.settings.show_secondary_image,
                            badge_style: section.settings.badge_style,
                            badge_text: section.settings.badge_text,
                            button_label: section.settings.button_label,
                            strike: true
                          %}
                        </div>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>

                {%- liquid
                  assign rl_nav = section.settings.products_navigation | default: 'pagination'
                  assign rl_shown = collection.products.size
                  assign rl_total = paginate.items
                  if rl_total == 0
                    assign rl_total = collection.products_count
                  endif
                  if rl_total > 0
                    assign rl_progress = rl_shown | times: 100.0 | divided_by: rl_total
                  else
                    assign rl_progress = 0
                  endif
                -%}

                {%- if rl_nav == 'load_more' -%}
                  {%- if rl_total > 0 -%}
                    <div
                      class="rl-loadmore"
                      data-rl-loadmore
                      data-rl-section="{{ section.id }}"
                      data-rl-total="{{ rl_total }}"
                    >
                      <p class="rl-loadmore__text" data-rl-loadmore-text>
                        Showing {{ rl_shown }} of {{ rl_total }} products
                      </p>
                      <span class="rl-loadmore__progress" aria-hidden="true">
                        <i style="width: {{ rl_progress }}%;" data-rl-loadmore-bar></i>
                      </span>
                      {%- if paginate.next -%}
                        <a
                          href="{{ paginate.next.url }}"
                          class="rl-loadmore__btn"
                          data-rl-loadmore-btn
                        >
                          Load More
                        </a>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                {%- elsif paginate.pages > 1 -%}
                  <div class="rl-pagination">
                    {% render 'pagination', paginate: paginate, anchor: '' %}
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endpaginate -%}
    {% if section.settings.image_shape == 'arch' %}
      {{ 'mask-arch.svg' | inline_asset_content }}
    {%- endif -%}
  </div>
</collection-component>

{% schema %}
{
  "name": "t:sections.main-collection-product-grid.name",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 36,
      "step": 1,
      "default": 16,
      "label": "t:sections.main-collection-product-grid.settings.products_per_page.label"
    },
    {
      "type": "select",
      "id": "products_navigation",
      "options": [
        { "value": "pagination", "label": "Pagination" },
        { "value": "load_more", "label": "Load more button" }
      ],
      "default": "pagination",
      "label": "Product navigation",
      "info": "Pagination shows page numbers. Load more appends the next page of products."
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "t:sections.main-collection-product-grid.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "t:sections.main-collection-product-grid.settings.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.main-collection-product-grid.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.main-collection-product-grid.settings.columns_mobile.options__2.label"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.main-collection-product-grid.settings.header__3.content"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__3.label"
        }
      ],
      "default": "adapt",
      "label": "t:sections.main-collection-product-grid.settings.image_ratio.label"
    },
    {
      "type": "select",
      "id": "image_shape",
      "options": [
        {
          "value": "default",
          "label": "t:sections.all.image_shape.options__1.label"
        },
        {
          "value": "arch",
          "label": "t:sections.all.image_shape.options__2.label"
        },
        {
          "value": "blob",
          "label": "t:sections.all.image_shape.options__3.label"
        },
        {
          "value": "chevronleft",
          "label": "t:sections.all.image_shape.options__4.label"
        },
        {
          "value": "chevronright",
          "label": "t:sections.all.image_shape.options__5.label"
        },
        {
          "value": "diamond",
          "label": "t:sections.all.image_shape.options__6.label"
        },
        {
          "value": "parallelogram",
          "label": "t:sections.all.image_shape.options__7.label"
        },
        {
          "value": "round",
          "label": "t:sections.all.image_shape.options__8.label"
        }
      ],
      "default": "default",
      "label": "t:sections.all.image_shape.label"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": false,
      "label": "t:sections.main-collection-product-grid.settings.show_secondary_image.label"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.show_vendor.label"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.show_rating.label",
      "info": "Static 4-star rating on Redline cards"
    },
    {
      "type": "select",
      "id": "badge_style",
      "options": [
        { "value": "amount", "label": "Save amount" },
        { "value": "percent", "label": "Save percent" },
        { "value": "none", "label": "Hide badge" }
      ],
      "default": "amount",
      "label": "Sale badge"
    },
    {
      "type": "text",
      "id": "badge_text",
      "default": "Save",
      "label": "Sale badge text"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "View Product",
      "label": "Card button label"
    },
    {
      "type": "select",
      "id": "quick_add",
      "default": "none",
      "label": "t:sections.main-collection-product-grid.settings.quick_add.label",
      "info": "Not used with Redline cards",
      "options": [
        {
          "value": "none",
          "label": "t:sections.main-collection-product-grid.settings.quick_add.options.option_1"
        },
        {
          "value": "standard",
          "label": "t:sections.main-collection-product-grid.settings.quick_add.options.option_2"
        },
        {
          "value": "bulk",
          "label": "t:sections.main-collection-product-grid.settings.quick_add.options.option_3"
        }
      ]
    },
    {
      "type": "header",
      "content": "Filters sidebar"
    },
    {
      "type": "checkbox",
      "id": "sticky_filters",
      "default": false,
      "label": "Sticky filters sidebar",
      "info": "Keeps filters visible while scrolling the product grid"
    },
    {
      "type": "header",
      "content": "List & grid view"
    },
    {
      "type": "select",
      "id": "layout_options",
      "options": [
        { "value": "both", "label": "Grid and list" },
        { "value": "grid", "label": "Grid only" },
        { "value": "list", "label": "List only" }
      ],
      "default": "both",
      "label": "Layout options"
    },
    {
      "type": "select",
      "id": "default_view",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "list", "label": "List" }
      ],
      "default": "grid",
      "label": "Default view",
      "info": "Used when Layout options is Grid and list"
    },
    {
      "type": "checkbox",
      "id": "enable_view_toggle",
      "default": true,
      "label": "Show list / grid toggle",
      "info": "Deprecated — use Layout options instead"
    },
    {
      "type": "header",
      "content": "t:sections.main-collection-product-grid.settings.header__1.content"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.enable_filtering.label",
      "info": "t:sections.main-collection-product-grid.settings.enable_filtering.info"
    },
    {
      "type": "select",
      "id": "filter_type",
      "options": [
        {
          "value": "horizontal",
          "label": "t:sections.main-collection-product-grid.settings.filter_type.options__1.label"
        },
        {
          "value": "vertical",
          "label": "t:sections.main-collection-product-grid.settings.filter_type.options__2.label"
        },
        {
          "value": "drawer",
          "label": "t:sections.main-collection-product-grid.settings.filter_type.options__3.label"
        }
      ],
      "default": "vertical",
      "label": "t:sections.main-collection-product-grid.settings.filter_type.label",
      "info": "Use Vertical for filters on the left (Redline layout)"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.enable_sorting.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
