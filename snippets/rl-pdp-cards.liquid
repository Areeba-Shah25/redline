{%- comment -%} rl-pdp-cards — two small info cards (free delivery / shipping transparency). Params: block {%- endcomment -%}
{%- assign b = block.settings -%}
<div class="rl-ic" {{ block.shopify_attributes }}>
  {%- for n in (1..2) -%}
    {%- if n == 1 -%}{%- assign ic = b.card1_icon -%}{%- assign tt = b.card1_title -%}{%- assign tx = b.card1_text -%}
    {%- else -%}{%- assign ic = b.card2_icon -%}{%- assign tt = b.card2_title -%}{%- assign tx = b.card2_text -%}{%- endif -%}
    {%- if tt != blank -%}
      <div class="rl-ic__card">
        <span class="rl-ic__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            {%- case ic -%}
              {%- when 'tag' -%}<path d="M3 12V4h8l10 10-8 8z"/><circle cx="7.5" cy="8.5" r="1.2"/>
              {%- when 'shield' -%}<path d="M12 3l7.5 3v5.5c0 4.5-3 8-7.5 9.5-4.5-1.5-7.5-5-7.5-9.5V6L12 3z"/>
              {%- when 'chat' -%}<path d="M4 5h16v10H10l-4 4v-4H4z"/>
              {%- when 'card' -%}<rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 10h18"/>
              {%- else -%}<path d="M2 6h11v9H2z"/><path d="M13 9h4l3 3v3h-7"/><circle cx="6.5" cy="17" r="1.8"/><circle cx="16.5" cy="17" r="1.8"/>
            {%- endcase -%}
          </svg>
        </span>
        <div><strong>{{ tt }}</strong><span>{{ tx }}</span></div>
      </div>
    {%- endif -%}
  {%- endfor -%}
</div>
